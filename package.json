{
  "name": "backend-caps2tone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo": "tsx scripts/demo-seed.ts",
    "assets:import": "tsx scripts/import-assets.ts",
    "docs:generate": "tsx scripts/openapi.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:write": "tsx scripts/smoke-write.ts",
    "http:probe": "tsx scripts/http-probe.ts",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@vercel/functions": "^3.10.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.1"
  }
}
